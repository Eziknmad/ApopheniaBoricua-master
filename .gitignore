# Next.js (my-app has its own nested .gitignore too; this is a top-level backstop)
node_modules/
.next/
out/
*.tsbuildinfo

# Jekyll (my-awesome-site)
my-awesome-site/_site/
my-awesome-site/.jekyll-cache/
my-awesome-site/.bundle/
my-awesome-site/vendor/

# Env / secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc

# Claude Code local settings (machine-specific, not project content)
.claude/

# FeeDesktopDbus-master is its own independent git project (remote:
# git@gitlab.com:pareidoliaboricua/FeeDesktopDbus-master.git) with real
# commit history. It's kept on disk here for convenience but intentionally
# NOT folded into this repo's history -- push/pull it via its own .git.
PareidoliaBoricua/FeeDesktopDbus-master/

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
